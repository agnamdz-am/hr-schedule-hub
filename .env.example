# Salin menjadi .env lalu sesuaikan. File .env tidak boleh di-commit.
PORT=3000
# Wajib diganti dengan string acak panjang di produksi, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
# Lokasi file database SQLite
DB_PATH=./data/hr.db
# Zona waktu perusahaan, dipakai untuk menentukan "hari ini" di server
APP_TIMEZONE=Asia/Jakarta
# true = halaman login menampilkan akun contoh. Ubah ke false untuk deployment sungguhan.
DEMO_MODE=true
# true bila aplikasi berjalan di belakang proxy hosting (Render, Railway, Fly.io)
TRUST_PROXY=false
NODE_ENV=development
